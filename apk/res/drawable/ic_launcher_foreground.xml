    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group android:pivotX="256" android:pivotY="256" android:scaleX="0.9" android:scaleY="0.9">

        <!-- sakura: 5 pétalas em torno do centro -->
        <group android:pivotX="256" android:pivotY="256" android:rotation="0">
            <path android:fillColor="#422a1550"
                android:pathData="M256,66 C285.8,66 310,101.8 310,146 C310,190.2 285.8,226 256,226 C226.2,226 202,190.2 202,146 C202,101.8 226.2,66 256,66 Z" />
        </group>
        <group android:pivotX="256" android:pivotY="256" android:rotation="72">
            <path android:fillColor="#422a1550"
                android:pathData="M256,66 C285.8,66 310,101.8 310,146 C310,190.2 285.8,226 256,226 C226.2,226 202,190.2 202,146 C202,101.8 226.2,66 256,66 Z" />
        </group>
        <group android:pivotX="256" android:pivotY="256" android:rotation="144">
            <path android:fillColor="#422a1550"
                android:pathData="M256,66 C285.8,66 310,101.8 310,146 C310,190.2 285.8,226 256,226 C226.2,226 202,190.2 202,146 C202,101.8 226.2,66 256,66 Z" />
        </group>
        <group android:pivotX="256" android:pivotY="256" android:rotation="216">
            <path android:fillColor="#422a1550"
                android:pathData="M256,66 C285.8,66 310,101.8 310,146 C310,190.2 285.8,226 256,226 C226.2,226 202,190.2 202,146 C202,101.8 226.2,66 256,66 Z" />
        </group>
        <group android:pivotX="256" android:pivotY="256" android:rotation="288">
            <path android:fillColor="#422a1550"
                android:pathData="M256,66 C285.8,66 310,101.8 310,146 C310,190.2 285.8,226 256,226 C226.2,226 202,190.2 202,146 C202,101.8 226.2,66 256,66 Z" />
        </group>
        <path android:fillColor="#422a1550"
            android:pathData="M256,226 C272.6,226 286,239.4 286,256 C286,272.6 272.6,286 256,286 C239.4,286 226,272.6 226,256 C226,239.4 239.4,226 256,226 Z" />

        <!-- sombra do play: mesmo triângulo 5/9dp à direita e abaixo -->
        <path
            android:fillColor="#331b1030"
            android:strokeColor="#331b1030"
            android:strokeWidth="44"
            android:strokeLineJoin="round"
            android:pathData="M191,141 L191,389 L397,265 Z" />
        <!-- play -->
        <path
            android:fillColor="#ffffffff"
            android:strokeColor="#ffffffff"
            android:strokeWidth="44"
            android:strokeLineJoin="round"
            android:pathData="M186,132 L186,380 L392,256 Z" />
    </group>
</vector>
